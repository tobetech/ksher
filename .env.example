PORT=8787
DEVICE_TOKEN=9f2c8a7b6e1d4c3f9a0b8e7d6c5a4b3

# Set true while testing ESP32 UI without calling Ksher.
KSHER_MOCK=true

KSHER_API_BASE=https://api.mch.ksher.net/KsherPay
KSHER_APPID=mch00000
KSHER_CHANNEL=promptpay
KSHER_FEE_TYPE=THB
KSHER_PRODUCT=ESP32 Kiosk
KSHER_VERSION=3.0.0

# Public HTTPS URL that Ksher can call. Leave blank if you only poll.
KSHER_NOTIFY_URL=

# Download from Ksher merchant portal.
KSHER_PRIVATE_KEY_PATH=./privatekey.pem

# For Vercel, paste privatekey.pem into this value.
# Keep literal \n line breaks if you paste it as one line.
KSHER_PRIVATE_KEY_PEM=

# Optional response/webhook verification.
KSHER_VERIFY_RESPONSE=false
